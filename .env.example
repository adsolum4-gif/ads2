VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Sign-up OTP email (Resend + Supabase Edge Function) ─────────────────────
# Do NOT put RESEND keys in VITE_* vars — they belong only in Supabase secrets.
#
# 1) Resend (resend.com)
#    - Add & verify your domain (DNS at TrueHost: Resend shows DKIM/SPF/MX records).
#    - Create an API key with "Sending access".
#    - Note the From address, e.g. Adsterra <noreply@yourdomain.com>
#
# 2) Supabase Dashboard → Project → Edge Functions → Secrets (or Settings → Edge Functions):
#    RESEND_API_KEY=re_xxxxxxxx
#    RESEND_FROM=Adsterra <noreply@yourdomain.com>
#    (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are usually injected automatically.)
#
# 3) Deploy the send-otp function (from repo root):
#    supabase functions deploy send-otp --no-verify-jwt --project-ref YOUR_PROJECT_REF
#
# 4) Sign-up flow: /signup-otp → send-otp edge function → send_otp RPC → Resend email.
#
# RESEND_API_KEY=
# RESEND_FROM=Adsterra <noreply@yourdomain.com>

# GitHub (optional) — push to adsolum4-gif/ads; never VITE_* or commit real tokens
# GH_TOKEN=
# GITHUB_ADS_REMOTE=https://github.com/adsolum4-gif/ads.git
